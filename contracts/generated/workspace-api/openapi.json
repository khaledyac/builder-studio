      }
    },
    "/git/worktrees/{name}": {
      "delete": {
        "summary": "Git Remove Worktree",
        "operationId": "git_remove_worktree",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
