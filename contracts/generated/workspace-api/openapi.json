      }
    },
    "/preview": {
      "get": {
        "summary": "Preview Status",
        "operationId": "preview_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewStatus"
                }
              }
            }
          }
        }
      }
    },
    "/draft": {
      "post": {
        "summary": "Draft",
        "operationId": "draft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
