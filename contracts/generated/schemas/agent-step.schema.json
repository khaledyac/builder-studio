{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Builder Studio contracts 1.0.0. Generated from studio.contracts: edit the Pydantic models, then run `task contracts-gen`.",
  "title": "AgentStep",
  "$defs": {
    "AgentStepKind": {
      "enum": [
        "intake",
        "router",
        "fast",
        "lead",
        "worker"
      ],
      "type": "string"
    },
    "AppId": {
      "maxLength": 40,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
      "type": "string"
    },
    "CallContext": {
      "description": "The IDs that travel together: every model call, log line and agent step carries them.",
      "properties": {
        "user_id": {
          "$ref": "#/$defs/UserId"
        },
        "app_id": {
          "$ref": "#/$defs/AppId"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "user_id",
        "app_id",
        "session_id"
      ],
      "title": "CallContext",
      "type": "object"
    },
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "type": "string"
    },
    "SessionId": {
      "maxLength": 32,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
      "type": "string"
    },
    "UserId": {
      "pattern": "^[A-Za-z0-9]{1,64}$",
      "type": "string"
    }
  },
  "properties": {
    "contract_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/CallContext"
    },
    "kind": {
      "$ref": "#/$defs/AgentStepKind"
    },
    "input": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    }
  },
  "required": [
    "contract_version",
    "context",
    "kind",
    "input",
    "idempotency_key"
  ],
  "type": "object"
}
