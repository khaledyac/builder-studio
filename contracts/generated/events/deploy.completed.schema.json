{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Builder Studio contracts 1.0.0. Generated from studio.contracts: edit the Pydantic models, then run task contracts-gen.",
  "title": "DeployCompleted",
  "$defs": {
    "AppId": {
      "maxLength": 40,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
      "type": "string"
    },
    "DeployData": {
      "properties": {
        "app_id": {
          "$ref": "#/$defs/AppId"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "version": {
          "$ref": "#/$defs/Semver"
        },
        "outcome": {
          "enum": [
            "success",
            "failure"
          ],
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "environment",
        "version",
        "outcome"
      ],
      "title": "DeployData",
      "type": "object"
    },
    "Environment": {
      "enum": [
        "lab",
        "staging",
        "production"
      ],
      "type": "string"
    },
    "Semver": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "properties": {
    "specversion": {
      "const": "1.0",
      "default": "1.0",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "type": "string"
    },
    "datacontenttype": {
      "const": "application/json",
      "default": "application/json",
      "type": "string"
    },
    "contractversion": {
      "description": "The contracts version it was written with. Readers accept 1.x.",
      "pattern": "^1\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    },
    "type": {
      "const": "deploy.completed",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/DeployData"
    }
  },
  "required": [
    "id",
    "source",
    "time",
    "contractversion",
    "type",
    "data"
  ],
  "type": "object"
}
